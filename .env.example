# Valheim server environment config
# Copie para ~/valheim/.env no servidor e preencha os valores reais.
# NÃO comite o .env real (está no .gitignore).
# Os valores reais ficam SOMENTE no ~/valheim/.env do servidor.

# URL do Incoming Webhook do Discord (canal de notificações do servidor)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_WEBHOOK_ID/SEU_WEBHOOK_TOKEN

# Senha do servidor Valheim (lida pelo start_valheim.sh)
VALHEIM_PASSWORD=COLE_A_SENHA_AQUI

# (opcional) Token DuckDNS — lido pelo ddns-update.sh
# DUCKDNS_TOKEN=seu_token

# Identidade usada nas notificações
SERVER_NAME=MundoVanir

# Discord Bot (comandos slash /server, /players) — NÃO é o webhook.
# Crie um Application+Bot no Discord Developer Portal e cole o token aqui.
DISCORD_BOT_TOKEN=COLE_SEU_BOT_TOKEN_AQUI

# Opcional: ID do servidor (guild) p/ comandos aparecerem na hora.
# Aceita DISCORD_GUILD_ID ou DISCORD_SERVER_ID (o bot lê os dois).
# DISCORD_GUILD_ID=seu_guild_id
# DISCORD_SERVER_ID=seu_server_id

# Opcional: restringe os comandos a UM canal especifico (Botão direito no canal
# → Copiar ID do Canal). Se vazio, funciona em qualquer canal do servidor.
# DISCORD_VALHEIM_CHANNEL_ID=seu_channel_id

# Metadados do Application (não são usados pelo bot via gateway, mas úteis
# caso você implemente interações via HTTP). Não são segredos críticos, mas
# evite commitar o PUBLIC_KEY junto com o token.
# DISCORD_APPLICATION_ID=seu_application_id
# DISCORD_PUBLIC_KEY=seu_public_key
